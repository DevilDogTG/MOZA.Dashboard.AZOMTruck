                                "Telemetry.get(\"v1/gameData/Gear\").value",
                                "((r=Number(_result))=>{if(isNaN(r))return _result;else if(r==0)return'N';else if(r>0)return r.toString();else if(r==-1)return 'R';else if(r<-1)return 'R'+Math.abs(r).toString();})()"
