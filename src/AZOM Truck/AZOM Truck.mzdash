                            "methods": [
                                "\n(() => {\n  const gear = Telemetry.get(\"v1/gameData/Gear\")?.value;\n  if (gear == '0') return 'N';\n  if (gear == '-1') return 'R1';\n  if (gear == '-2') return 'R2';\n  if (gear == '-3') return 'R3';\n  if (gear == '-4') return 'R4';\n  return gear;\n})()",
